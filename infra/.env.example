# Copy to infra/.env for local Docker use:   cp infra/.env.example infra/.env
# PLACEHOLDERS ONLY. Real values live in Coolify secrets, never in Git (spec §10B).

# --- PostgreSQL ---
POSTGRES_DB=gin_cabinet
POSTGRES_USER=gin
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- API (every app setting starts with GC_, see apps/api/app/config.py) ---
GC_DATABASE_URL=postgresql+psycopg://gin:change-me-to-a-long-random-password@db:5432/gin_cabinet
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GC_SECRET_KEY=change-me-generate-a-long-random-secret-key
GC_ALLOWED_ORIGINS=http://localhost:3000
# false only for local http:// testing. Production MUST be true (HTTPS).
GC_COOKIE_SECURE=false
GC_ENVIRONMENT=development
# IP of the reverse proxy whose X-Forwarded-For header we trust.
FORWARDED_ALLOW_IPS=127.0.0.1
